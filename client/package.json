{
  "name": "sl-meet-client",
  "version": "2.0.1",
  "description": "SLMeet: Real-time Sign Language & AI-powered Meeting App",
  "author": "SLMeet Team",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/**/*.test.mjs",
    "electron:dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:pack": "vite build && electron-builder --dir",
    "electron:publish": "node ../scripts/release-desktop.mjs"
  },
  "build": {
    "appId": "com.slmeet.app",
    "productName": "SLMeet",
    "electronVersion": "29.4.6",
    "copyright": "Copyright © 2026 SLMeet",
    "publish": [
      {
        "provider": "github",
        "owner": "vtniscoding",
        "repo": "SL-Meet",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/assets/icons/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SLMeet",
      "uninstallDisplayName": "SLMeet",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@huggingface/transformers": "^4.3.1",
    "@mediapipe/drawing_utils": "^0.3.1675466124",
    "@mediapipe/hands": "^0.4.1675469240",
    "@ricky0123/vad-web": "^0.0.31",
    "@sl-meet/shared": "*",
    "@supabase/supabase-js": "^2.117.3",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.4.21",
    "wait-on": "^7.2.0"
  }
}
